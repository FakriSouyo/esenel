[TEMPLATE]
# Supabase — copy to .env.local and fill in real values
# Project ref: jimsgyrsgygicxwyuqzo (region: Oceania/Sydney)
# Get the URL + anon key:  supabase projects api-keys --project-ref jimsgyrsgygicxwyuqzo
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# DeepSeek — untuk "buat bunga dari namamu" (/craft/name), storytelling + nama buket.
# Opsional: kalau kosong, halaman pakai dummy response supaya UI tetap jalan.
# Ambil key di https://platform.deepseek.com → API Keys. JANGAN di-commit.
DEEPSEEK_API_KEY=<your-deepseek-key>

# Google Gemini — generate gambar buket di /craft/name (dipakai DULU, hasil lebih bagus).
# Kalau kosong / gagal, otomatis fallback ke pollinations.ai (free, tanpa key).
# Ambil key di https://aistudio.google.com/apikey. JANGAN di-commit.
GEMINI_API_KEY=<your-gemini-key>
# Opsional: model gambar Gemini (default gemini-3.1-flash-image).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
