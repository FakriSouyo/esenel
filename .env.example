# Supabase — copy to .env.local and fill in real values
# Project ref: jimsgyrsgygicxwyuqzo (region: Oceania/Sydney)
# Get the URL + anon key:  supabase projects api-keys --project-ref jimsgyrsgygicxwyuqzo
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Cloudflare Worker Image Generation — generate gambar buket di /craft/name (provider UTAMA).
# Endpoint: https://esenel.fakritrk.workers.dev/ (POST { prompt }, header Authorization: Bearer).
# Kalau kosong / gagal, otomatis fallback ke pollinations.ai. JANGAN di-commit.
CLOUDFLARE_WORKER_API_KEY=<your-cloudflare-worker-api-key>
# Opsional: override endpoint worker (default https://esenel.fakritrk.workers.dev/).
# CLOUDFLARE_WORKER_ENDPOINT=https://esenel.fakritrk.workers.dev/

# DeepSeek — untuk "buat bunga dari namamu" (/craft/name), storytelling + nama buket.
# Opsional: kalau kosong, halaman pakai dummy response supaya UI tetap jalan.
# Ambil key di https://platform.deepseek.com → API Keys. JANGAN di-commit.
DEEPSEEK_API_KEY=<your-deepseek-key>

# Google Gemini — text-only: dipakai memverifikasi hasil gambar pollinations
# (cek anti-makhluk-hidup lewat model teks-gambar). TIDAK dipakai generate gambar.
# Kalau kosong, gambar pollinations diterima apa adanya (best effort).
# Ambil key di https://aistudio.google.com/apikey. JANGAN di-commit.
GEMINI_API_KEY=<your-gemini-key>
# Opsional: model teks-gambar untuk cek anti-makhluk-hidup.
GEMINI_VISION_MODEL=gemini-flash-latest

# ─────────────────────────────────────────────────────────────────────────────
# Alibaba Cloud DashScope — provider image generation + fallback story generation.
# Workspace: Fakri, Region: ap-southeast-1 (Singapore)
# Ambil key di https://dashscope.console.aliyun.com → API Keys. JANGAN di-commit.
# ─────────────────────────────────────────────────────────────────────────────
ALIBABA_API_KEY=<your-alibaba-dashscope-api-key>
# Workspace ID (default: ws-1lzc28wlxlkdkgzm)
ALIBABA_WORKSPACE_ID=ws-1lzc28wlxlkdkgzm
# Endpoint OpenAI-compatible untuk text generation (fallback story)
# Default: https://ws-1lzc28wlxlkdkgzm.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_ENDPOINT=https://ws-1lzc28wlxlkdkgzm.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Model untuk image generation (default: qwen-image-3.0-pro)
# Opsi lain: qwen-image-3.0 (standard), qwen-image-2.0-pro (sebelumnya)
ALIBABA_IMAGE_MODEL=qwen-image-3.0-pro
# Base URL untuk referensi gambar (default: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
