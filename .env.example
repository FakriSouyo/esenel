# Supabase — copy to .env.local and fill in real values
# Project ref: jimsgyrsgygicxwyuqzo (region: Oceania/Sydney)
# Get the URL + anon key:  supabase projects api-keys --project-ref jimsgyrsgygicxwyuqzo
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Cloudflare Worker Image Generation — generate gambar buket di /craft/name (provider UTAMA).
# Endpoint: https://esenel.fakritrk.workers.dev/ (POST { prompt }, header Authorization: Bearer).
# Kalau kosong / gagal, otomatis fallback ke pollinations.ai. JANGAN di-commit.
CLOUDFLARE_WORKER_API_KEY=<your-cloudflare-worker-api-key>
# Opsional: override endpoint worker (default https://esenel.fakritrk.workers.dev/).
# CLOUDFLARE_WORKER_ENDPOINT=https://esenel.fakritrk.workers.dev/

# DeepSeek — legacy text provider langsung dari platform.deepseek.com.
# Tidak lagi dipakai sebagai provider utama — Bitdeer AI (DeepSeek-V4-Flash)
# yang jadi primary; DeepSeek asli dipertahankan sebagai opsi.
# Ambil key di https://platform.deepseek.com → API Keys. JANGAN di-commit.
DEEPSEEK_API_KEY=<your-deepseek-key>

# Google Gemini — text-only: dipakai memverifikasi hasil gambar pollinations
# (cek anti-makhluk-hidup lewat model teks-gambar) DAN sebagai fallback
# story generation kalau Bitdeer AI gagal. TIDAK dipakai generate gambar.
# Ambil key di https://aistudio.google.com/apikey. JANGAN di-commit.
GEMINI_API_KEY=<your-gemini-key>
# Opsional: model teks utk fallback story (default gemini-flash-latest).
GEMINI_TEXT_MODEL=gemini-flash-latest
# Opsional: model teks-gambar untuk cek anti-makhluk-hidup.
GEMINI_VISION_MODEL=gemini-flash-latest

# ─────────────────────────────────────────────────────────────────────────────
# Bitdeer AI Inference — provider UTAMA untuk "buat bunga dari namamu" (/craft/name).
# Image generation: POST https://api-inference.bitdeer.ai/v1/images/generations
#   { prompt, size, model: "black-forest-labs/FLUX-2-pro", n: 1 }
# Story generation: POST https://api-inference.bitdeer.ai/v1/chat/completions
#   { model: "deepseek-ai/DeepSeek-V4-Flash", messages, ... }
# Ambil key di https://console.bitdeer.com/ → API Keys. JANGAN di-commit.
# ─────────────────────────────────────────────────────────────────────────────
BITDEER_API_KEY=<your-bitdeer-api-key>
# Opsional: override model image (default black-forest-labs/FLUX-2-pro)
BITDEER_IMAGE_MODEL=black-forest-labs/FLUX-2-pro
# Opsional: override model text/story (default deepseek-ai/DeepSeek-V4-Flash)
BITDEER_TEXT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Opsional: ukuran gambar output (default 1024x1024)
BITDEER_IMAGE_SIZE=1024x1024
# Base URL untuk referensi gambar (default: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
